__pycache__/
*.py[cod]
.venv/
venv/

# Captured imagery and derived products can run to many GB. Written as
# "ignore the contents, then re-include what matters" rather than "ignore the
# directory": git does not descend into an excluded directory at all, so a
# plain `data/` rule makes every negation below it dead -- the label files
# stayed ignored no matter what was added.
data/*
!data/captures/
data/captures/*
!data/captures/*/
data/captures/*/*
data/datasets/
data/outputs/
data/raw/

# The labels ARE the project. Jbeil's took days of hand review and Jounieh's
# is days more; imagery re-downloads in minutes and checkpoints retrain, but a
# label file cannot be reconstructed from anything. ~1.4 MB, and the only
# artefact here that is genuinely irreplaceable.
!data/captures/*/labels*.json
!data/captures/*/corrections.geojson
!data/captures/*/manifest.json

# Model checkpoints. Note the .zip: a torch checkpoint IS a zip archive, and
# downloads from Colab or Kaggle often arrive with that extension -- which
# slipped past a *.pt-only rule and nearly put 98 MB into a commit.
models/*.pt
models/*.zip

# Model artefacts and archived experiments
models/*.pkl
models/archive/
models/runs/

# Never commit credentials
*.token
secrets.*

# Raw YOLO training checkpoints from the original run (~9 GB)
unet-training/

# ...but the working detector must ship with the code
!models/box_filter.pkl
